# Copy outside the checkout or to ignored deploy/application.env; chmod 600.
# This file is an example, not read automatically by Python or the CLI tools.
TRACERAG_DB_PASSWORD=replace-with-unique-dedicated-password
TRACERAG_MODEL_KEY=replace-explicitly-do-not-use-experiment-credentials
TRACERAG_DB_NAME=tracerag_application
TRACERAG_HTTP_PORT=18000
TRACERAG_EMBEDDING_DIM=1536
# Default true requires HTTPS for session cookies. Disable only for localhost HTTP.
TRACERAG_COOKIE_SECURE=true
# Existing private directory, preferably on an encrypted filesystem, never git.
TRACERAG_BACKUP_DIR=/absolute/private/tracerag-backups
# Unverified checked-in rates intentionally fail closed. No automatic credits.
TRACERAG_PRICING_FILE=./configs/providers/application-budget.example.json
