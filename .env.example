# --- OpenAI (default) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Alternative: Google Gemini (free tier, OpenAI-compatible) ---
# Get a free key at https://aistudio.google.com/apikey
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001   # supports dimensions=768/1536/3072
# OPENAI_CHAT_MODEL=gemini-2.5-flash
# EMBEDDING_DIM=768

# --- Alternative: Ollama (free, fully local) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_EMBEDDING_MODEL=nomic-embed-text
# OPENAI_CHAT_MODEL=llama3.2
# EMBEDDING_DIM=768

# --- Alternative: SiliconFlow (copy these values into .env; replace defaults) ---
# MODEL_PROVIDER=siliconflow
# OPENAI_API_KEY=                  # fill locally, never commit
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024
# OPENAI_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# LLM_RERANK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# LLM_RERANK_ENABLE_THINKING=false  # opt-in rerank only; unset preserves provider default
# NATIVE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# SILICONFLOW_LLM_MAX_TOKENS=1024
# SILICONFLOW_GENERATION_MAX_TOKENS=2048
# SILICONFLOW_PRICING_FILE=configs/providers/siliconflow.pricing.json
# SILICONFLOW_COST_LOG=runs/siliconflow-costs.jsonl  # usage + estimated CNY, not billed cost
# SILICONFLOW_MAX_COST_CNY=0         # deprecated; historical smoke scripts only
# Runtime/new baseline record cost without spend caps or reservations.
# RUN_DB_INIT=false
# Native /rerank is experimental, NOT used by the baseline search pipeline.
# Prices/ID recorded from console screenshots; limits/usage still pending.
# See docs/CONFIGURATION.md; historical rates do not authorize application calls.

# --- Optional: DeepSeek official chat + SiliconFlow BGE models ---
# Keep the SiliconFlow OPENAI_API_KEY/BASE_URL and BGE settings above.
# DEEPSEEK_API_KEY=                # separate official key; fill locally
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_CHAT_MODEL=deepseek-flash
# LLM_RERANK_MODEL=deepseek-flash
# Applies to generation + LLM reranking, not embedding/native reranking.
# SiliconFlow thinking controls/pricing do not apply to official DeepSeek calls.

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
EMBEDDING_DIM=1536

# --- Retrieval pipeline ---
RETRIEVAL_CANDIDATES=10   # candidates per retriever before fusion/rerank
USE_HYBRID=true           # vector + keyword search (RRF)
USE_RERANK=true           # LLM re-ranking of fused candidates
RERANK_PASSAGE_MODE=prefix_600  # historical default; opt-in full_chunk sends all chunk text
RERANK_PROMPT_VERSION=baseline  # opt-in keyed_v1 / relevance_v1; frozen default unchanged
MIN_RELEVANCE=0.12        # below this top cosine sim, decline instead of guessing

# --- Application call limits (separate from cumulative estimate budget) ---
RATE_LIMIT_ENABLED=true  # false is for isolated offline demos/tests only
RATE_LIMIT_PER_MINUTE=10  # per account, shared across libraries; authenticated RAG POSTs
ACCOUNT_CONCURRENCY=2     # held through response/stream completion
APPLICATION_CONCURRENCY=4 # shared provider-operation slots across API/worker processes
PROVIDER_TIMEOUT_SECONDS=20  # SDK connect/read/write/pool timeout, not whole-request deadline
PROVIDER_MAX_ATTEMPTS=2      # total attempts, SDK internal retries disabled in application
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
APPLICATION_GENERATION_MAX_TOKENS=2048
APPLICATION_RERANK_MAX_TOKENS=1024

# --- Application cumulative budget: no production opt-out ---
# The checked-in example is UNVERIFIED and refuses model calls by default.
# Supply audited CNY rates + whole-request bounds for each exact endpoint/model/role;
# explicitly migrate v3 with 003 and set global + account limits using admin CLI.
# No automatic reset/credit. Unknown charges retain their holds until explicit audit.
APPLICATION_PRICING_FILE=configs/providers/application-budget.example.json

# --- Query traces (v5 / explicit migration 004) ---
# Metadata only by default; retain_trace_content=true consents for ONE request.
# Visible for 7 days. Arrange explicit expiry cleanup with manage_application_traces.
# Trace cleanup does not refund budget or remove provider/browser/backup copies.
# See docs/CONFIGURATION.md; no production trace-body logging opt-in.

# --- Feedback (v6 / explicit migration 005) ---
# Fixed labels only, expires/deletes with trace; no TTL extension or free-text note.
# Metadata export by default. Full cases require per-export manual review; no raw mode.
# Edited export bodies are not retained; never enable request body logging.
# Offline check_feedback_regression does not call providers or judge semantic support.
# See docs/CONFIGURATION.md and docs/DEVELOPMENT.md.

# --- Local controlled deployment/recovery (v7 / explicit migration 006) ---
# Use compose.application.yml with an EXPLICIT deploy/application.env file.
# Compose forces these two values; do not use create_all as a migration tool:
# RUN_DB_INIT=false
# APPLICATION_STARTUP_CHECK=true
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# /health is liveness; /ready checks DB/schema/restore guard without model calls.
# Restore NEW EMPTY DB only, revoke sessions/block budgets/pause pending jobs.
# Recovery guard on auth/worker is unconditional; no automatic refund or retry.
# See docs/OPERATIONS.md; TLS/public production not certified.
